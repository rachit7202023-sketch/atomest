# Client-side (safe to expose in browser)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_AI_PROVIDER=gemini
VITE_GA_MEASUREMENT_ID=

# Server-side only (NEVER commit, never expose to browser)
# Required for serverless API routes to write to Supabase bypassing RLS
SUPABASE_SERVICE_ROLE_KEY=

# Legacy server-side Gemini key (deprecated — consolidate to client-side provider)
GOOGLE_GENERATIVE_AI_API_KEY=
