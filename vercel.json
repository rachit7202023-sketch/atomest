{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "redirects": [
    { "source": "/tools", "destination": "/solutions/automation", "permanent": true },
    { "source": "/tools/:path*", "destination": "/solutions/automation", "permanent": true },
    { "source": "/categories", "destination": "/solutions/automation", "permanent": true },
    { "source": "/categories/:path*", "destination": "/solutions/automation", "permanent": true },
    { "source": "/products", "destination": "/solutions/products", "permanent": true },
    { "source": "/ai-products", "destination": "/solutions/products", "permanent": true },
    { "source": "/ai-products/:path*", "destination": "/solutions/products", "permanent": true },
    { "source": "/originals", "destination": "/solutions/products", "permanent": true },
    { "source": "/originals/:path*", "destination": "/solutions/products", "permanent": true },
    { "source": "/employees/:path*", "destination": "/solutions/agents", "permanent": true }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
